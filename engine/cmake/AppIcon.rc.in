// Generated by z_embed_app_icon() from engine/cmake/AppIcon.rc.in -- DO NOT EDIT.
// The artwork is @APP_ICON_NAME@.ico; regenerate it with
// engine/resource/gen_icon.ps1 -Name @APP_ICON_NAME@ -Motif <motif>
//
// Embedding the icon here covers Explorer and the file's Properties page only.
// The window's title bar, Alt-Tab entry and taskbar button come from the
// *window class* instead, which is a separate step:
//   ZSlate tools -> ZSlate::FStandaloneAppDesc::LargeIconResId / SmallIconResId
//   raw Win32    -> WNDCLASSEXW::hIcon / hIconSm  (WNDCLASSEX, not WNDCLASS:
//                   the plain class carries no hIconSm, so the taskbar would
//                   still show the system default icon)
//
// IDI_ICON1 comes from z_embed_app_icon() as a target compile definition, so no
// source file has to #define it by hand.
#define IDI_ICON1 101

IDI_ICON1               ICON                    "@APP_ICON_NAME@.ico"
