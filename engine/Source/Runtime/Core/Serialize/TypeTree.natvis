            <Item Name="[m_Type]" Condition="(m_TypeTreeData->m_Nodes[m_NodeIndex].m_TypeStrOffset &amp; TypeTree::kCommonStringBit) == 0">&amp;m_TypeTreeData->m_StringBuffer[0] + (m_TypeTreeData->m_Nodes[m_NodeIndex].m_TypeStrOffset &amp; TypeTree::kStringOffsetMask)</Item>
            <Item Name="[m_Name]" Condition="(m_TypeTreeData->m_Nodes[m_NodeIndex].m_NameStrOffset &amp; TypeTree::kCommonStringBit) != 0">CommonString::BufferBegin + (m_TypeTreeData->m_Nodes[m_NodeIndex].m_NameStrOffset &amp; TypeTree::kStringOffsetMask)</Item>
            <Item Name="[m_Name]" Condition="(m_TypeTreeData->m_Nodes[m_NodeIndex].m_NameStrOffset &amp; TypeTree::kCommonStringBit) == 0">&amp;m_TypeTreeData->m_StringBuffer[0] + (m_TypeTreeData->m_Nodes[m_NodeIndex].m_NameStrOffset &amp; TypeTree::kStringOffsetMask)</Item>
