    <Type Name="TypeTreeIterator">
        <DisplayString Condition="((m_TypeTreeData->m_Nodes[m_NodeIndex].m_TypeStrOffset &amp; TypeTree::kCommonStringBit) != 0) &amp;&amp; ((m_TypeTreeData->m_Nodes[m_NodeIndex].m_NameStrOffset &amp; TypeTree::kCommonStringBit) != 0) &amp;&amp; (m_TypeTreeData->m_Nodes[m_NodeIndex].m_ByteSize &lt;= 0)">{CommonString::BufferBegin + (m_TypeTreeData->m_Nodes[m_NodeIndex].m_NameStrOffset &amp; TypeTree::kStringOffsetMask),s} {CommonString::BufferBegin + (m_TypeTreeData->m_Nodes[m_NodeIndex].m_TypeStrOffset &amp; TypeTree::kStringOffsetMask),s}</DisplayString>
