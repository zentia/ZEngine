        <DisplayString Condition="((m_TypeTreeData->m_Nodes[m_NodeIndex].m_TypeStrOffset &amp; TypeTree::kCommonStringBit) == 0) &amp;&amp; ((m_TypeTreeData->m_Nodes[m_NodeIndex].m_NameStrOffset &amp; TypeTree::kCommonStringBit) != 0) &amp;&amp; (m_TypeTreeData->m_Nodes[m_NodeIndex].m_ByteSize &gt;= 0)">s:{m_TypeTreeData->m_Nodes[m_NodeIndex].m_ByteSize} {CommonString::BufferBegin + (m_TypeTreeData->m_Nodes[m_NodeIndex].m_NameStrOffset &amp; TypeTree::kStringOffsetMask),s} {&amp;m_TypeTreeData->m_StringBuffer[0] + (m_TypeTreeData->m_Nodes[m_NodeIndex].m_TypeStrOffset &amp; TypeTree::kStringOffsetMask),s}</DisplayString>
