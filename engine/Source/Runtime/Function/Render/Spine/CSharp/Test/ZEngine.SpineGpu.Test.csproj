<Project Sdk="Microsoft.NET.Sdk">

  <!-- 跨语言对拍：读 C++ 落出来的 .zspg，再写一遍，要求**逐字节相同**。
       不引第三方测试框架 —— 这台机器离线，NuGet 拉不动，而且需要的东西
       就只是一个退出码。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ZEngine.SpineGpu.Test</AssemblyName>
    <RootNamespace>ZEngine.SpineGpu.Test</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZEngine.SpineGpu.csproj" />
  </ItemGroup>

</Project>
