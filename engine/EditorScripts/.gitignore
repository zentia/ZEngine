# Regenerated by the editor on every start (EditorScriptingManager::WriteTypings).
# Listed individually, NOT as `typings/`: that also swallowed the hand-written
# typings/host.d.ts, so a fresh clone lost the `console` declaration and tsc
# reported spurious errors on the very first build.
typings/zengine.d.ts
typings/zengine-editor.d.ts
# Local tsc output; the shipped copy is built into <BinaryRoot>/EditorScripts.
dist/
node_modules/
