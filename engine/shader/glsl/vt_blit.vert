#version 450

// ===========================================================================
// VirtualTexture 离屏光栅验证——全屏三角形顶点着色器。
//
// 不绑任何顶点缓冲：位置和 UV 全由 gl_VertexIndex 算出。三个顶点
//   0:(-1,-1)  1:(3,-1)  2:(-1,3)
// 组成一个盖住整个 [-1,1]^2 的大三角形，比两个三角形的四边形少一条对角线接缝，也没有
// 逐顶点输入，是后处理里的标准写法。
//
// UV：NDC (-1,-1)（Vulkan 里是帧缓冲左上角）→ uv (0,0)，NDC (1,1) → uv (1,1)。
// 所以输出图像的第 0 行 == 虚拟纹理的第 0 行，读回的 (px,py) 可以直接和源纹理 (px,py)
// 按比例对应，不需要翻转。任何一侧翻 y 会让整张图上下颠倒、A/B 当场红。
// ===========================================================================

layout(location = 0) out vec2 v_uv;

void main()
{
    const vec2 corner = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
    v_uv = corner;
    gl_Position = vec4(corner * 2.0 - 1.0, 0.0, 1.0);
}
